{
  "extends": "@lcaba/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "strictNullChecks": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noUncheckedSideEffectImports": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
